# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — pooled connection string from the Neon dashboard.
# Use a Neon *dev branch* locally, the primary branch in production.
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob store — read/write token from the Vercel project's Storage tab.
BLOB_READ_WRITE_TOKEN=

# Public base URL, used for invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
