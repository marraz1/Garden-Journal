# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — pooled connection string from the Neon dashboard.
# Use a Neon *dev branch* locally, the primary branch in production.
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Email/password sign-in works without these. Filling them in additionally
# shows a "Sign in with Google" button; leaving them empty hides it.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Password-reset emails. Without a key the reset link is logged to the server
# console instead of being sent — fine locally, not in production.
RESEND_API_KEY=
EMAIL_FROM="Sodo žurnalas <onboarding@resend.dev>"

# Vercel Blob store — read/write token from the Vercel project's Storage tab.
BLOB_READ_WRITE_TOKEN=

# Public base URL, used for invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
